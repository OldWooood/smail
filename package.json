{
	"name": "smail",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "remix vite:build && wrangler pages functions build --outdir build/worker",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "remix vite:dev",
		"lint": "biome check .",
		"start": "wrangler pages dev ./build/client",
		"typecheck": "tsc",
		"typegen": "wrangler types",
		"preview": "pnpm run build && wrangler dev",
		"cf-typegen": "wrangler types",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@formatjs/intl-localematcher": "^0.5.10",
		"@marsidev/react-turnstile": "^1.6.1",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-slot": "^1.3.3",
		"@remix-run/cloudflare": "^2.17.5",
		"@remix-run/cloudflare-pages": "^2.17.5",
		"@remix-run/react": "^2.17.5",
		"@scaleway/random-name": "^5.1.4",
		"@uidotdev/usehooks": "^2.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.35.3",
		"isbot": "^5.2.2",
		"lucide-react": "^0.453.0",
		"marked": "^14.1.4",
		"motion": "^13.4.1",
		"nanoid": "^5.1.16",
		"negotiator": "^0.6.4",
		"postal-mime": "^2.7.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^2.6.1",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@remix-run/dev": "^2.17.5",
		"@types/negotiator": "^0.6.5",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.6.1",
		"drizzle-kit": "^0.26.2",
		"postcss": "^8.5.28",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "4.136.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
